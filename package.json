{
  "name": "text-to-sign-language",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Type a sentence and a 3D avatar signs it. Browser-based text-to-sign-language with an accessibility-first UI.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "license:check": "license-checker --production --onlyAllow \"MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;Unlicense;CC0-1.0;MPL-2.0;0BSD;Python-2.0\""
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "compromise": "^14.14.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "globals": "^17.13.0",
    "license-checker": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.4.10",
    "vitest": "^4.1.11"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/37OMKAR/signlanguage.git"
  },
  "homepage": "https://github.com/37OMKAR/signlanguage#readme",
  "bugs": {
    "url": "https://github.com/37OMKAR/signlanguage/issues"
  },
  "keywords": [
    "sign-language",
    "asl",
    "isl",
    "accessibility",
    "threejs",
    "react",
    "avatar",
    "mediapipe",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  }
