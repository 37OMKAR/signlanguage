# Copy to `.env` and set values. Never commit `.env`.

# URL of your AI proxy (see scripts/ai-proxy/). Leave blank to disable AI
# and use the rule-based gloss layer only.
VITE_AI_PROXY_URL=

# Default provider the frontend requests. The proxy validates.
# One of: gemini | claude-sonnet | claude-haiku | deepseek
VITE_AI_PROVIDER=gemini
